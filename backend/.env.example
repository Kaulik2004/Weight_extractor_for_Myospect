# Copy to backend/.env and fill in at least one key. Each key enables one engine.
# Restart the backend after editing.

# Google Gemini - https://aistudio.google.com/apikey (has a free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Anthropic Claude - https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# OpenAI (ChatGPT models) - https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-sol

# Groq - must be an image-capable model on your account; list them with:
#   curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY" \
#     | python -c "import json,sys; [print(m['id']) for m in json.load(sys.stdin)['data'] if 'image' in m.get('input_modalities', [])]"
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Images per Groq request; keep at or below your model's per-request cap.
GROQ_BATCH_SIZE=3

# Gemini / Claude / OpenAI: frames per request, and requests in parallel.
# Lower AI_CONCURRENCY if you see rate-limit (429) errors.
AI_BATCH_SIZE=24
AI_CONCURRENCY=4
